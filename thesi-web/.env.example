# Stripe.js (public). Same pk_test_ as STRIPE_PUBLISHABLE_KEY on thesi-api.
# Production images bake this at build (GitHub secret NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shows creator Settings → Payouts Connect onboarding. Does not enable deposits or settlement.
NEXT_PUBLIC_CREATOR_PAYOUTS_ENABLED=true
